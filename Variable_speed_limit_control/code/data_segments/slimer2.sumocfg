<configuration>
    <input>
        <net-file value="slimer2.net.xml"/>
        <route-files value="fourNode_slimer2.rou.xml"/>
    <gui-settings-file value="test.settings.xml"/>
    </input>
    
    <time>
        <begin value="0"/>
        <step-length value="1"/>
    </time>

    <output>
        <lanechange-output value="lanechange_exp.xml"/>
        <queue-output value="queue_exp.xml"/>
    </output>
    <random>
        <random value="false"/>
        <seed value="0"/>
    </random>
</configuration>
